# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Client-side Google Maps JavaScript & Places API key.
# Automatically provisioned via AI Studio Google Maps Platform integration.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Optional External Travel Inventory Provider Credentials (Demo mode active when unset)
FLIGHT_API_KEY=""
FLIGHT_API_PROVIDER=""
HOTEL_API_KEY=""
HOTEL_API_PROVIDER=""
